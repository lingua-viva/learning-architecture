{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-viva.local/docpipe/extraction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_sha256",
    "extracted_at",
    "extractor",
    "mime",
    "language",
    "normalized_text",
    "spans",
    "structure",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "docpipe.extraction.v1" },
    "source_id": { "type": "string", "pattern": "^SRC-[A-Za-z0-9_-]+$" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extracted_at": { "type": "string", "format": "date-time" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] }
      }
    },
    "mime": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "normalized_text": { "type": "string", "minLength": 1 },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["span_id", "char_start", "char_end", "text"],
        "properties": {
          "span_id": { "type": "string", "pattern": "^SPN-[A-Za-z0-9_-]+$" },
          "char_start": { "type": "integer", "minimum": 0 },
          "char_end": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "field_hint": { "type": "string", "minLength": 1 },
          "sheet": { "type": "string", "minLength": 1 },
          "row_index": { "type": "integer", "minimum": 1 },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "text"],
              "properties": {
                "column": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "document_type", "sections", "students_detected"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "document_type": {
          "enum": ["lesson_plan", "student_work_sample", "rubric", "report", "roster", "student_support", "unknown"]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "heading", "span_ids"],
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "heading": { "type": "string" },
              "span_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^SPN-[A-Za-z0-9_-]+$" }
              }
            }
          }
        },
        "students_detected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["student_id", "display_name", "confidence", "span_ids"],
            "properties": {
              "student_id": { "type": "string", "minLength": 1 },
              "display_name": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "enum": ["student_column", "per_class_sheet_support", "bigram_fallback", "model"] },
              "class": { "type": "string", "minLength": 1 },
              "grade": { "type": "string", "minLength": 1 },
              "teacher_attribution": { "type": "string", "minLength": 1 },
              "source_rows": { "type": "string", "minLength": 1 },
              "removal_proposed": { "type": "string", "minLength": 1 },
              "span_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^SPN-[A-Za-z0-9_-]+$" }
              }
            }
          }
        },
        "curriculum": { "type": "object" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
