{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-viva.local/docpipe/common.schema.json",
  "$defs": {
    "iso_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "confidence", "added_at", "added_by"],
      "properties": {
        "source_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["DOCUMENT", "OBSERVATION"] },
            "source_id": { "type": "string", "minLength": 1 },
            "obs_id": { "type": "string", "pattern": "^OBS-[A-Za-z0-9_-]+$" },
            "path": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "DOCUMENT" } }, "required": ["type"] },
              "then": { "required": ["source_id"] }
            },
            {
              "if": { "properties": { "type": { "const": "OBSERVATION" } }, "required": ["type"] },
              "then": { "required": ["obs_id"] }
            }
          ]
        },
        "span_id": { "type": "string", "pattern": "^SPN-[A-Za-z0-9_-]+$" },
        "obs_id": { "type": "string", "pattern": "^OBS-[A-Za-z0-9_-]+$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "added_at": { "$ref": "#/$defs/iso_datetime" },
        "added_by": { "type": "string", "minLength": 1 }
      }
    },
    "profile_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" },
            { "type": "array" },
            { "type": "object" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "value": { "type": "null" } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "value": { "type": "string", "maxLength": 0 } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "value": { "type": "array", "maxItems": 0 } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "value": { "type": "object", "maxProperties": 0 } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "value": { "type": "string", "minLength": 1 } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "value": { "type": "array", "minItems": 1 } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "value": { "type": "object", "minProperties": 1 } },
            "required": ["value"]
          },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    }
  }
}
